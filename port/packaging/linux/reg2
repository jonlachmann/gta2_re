#!/bin/sh
# Starts the game (bin/reg2, 32 or 64-bit) after checking that the system has the libraries it needs.
HERE=$(dirname "$(readlink -f "$0")")
# The ELF class of bin/reg2: 1 for 32-bit, 2 for 64-bit.
if [ "$(od -An -tu1 -j4 -N1 "$HERE/bin/reg2" | tr -d ' ')" = 2 ]; then
    BITS=64
    TAG="(libc6,x86-64)"
else
    BITS=32
    TAG="(libc6)"
    if [ ! -e /lib/ld-linux.so.2 ]; then
        echo "reg2: this system has no 32-bit libraries (/lib/ld-linux.so.2 is missing)." >&2
        echo "reg2: $HERE/README.md lists the packages to install." >&2
        exit 1
    fi
fi

# The libraries SDL loads when it starts, from the loader's cache (ldconfig -p tags each with its ABI).
LDCONFIG=$(PATH=$PATH:/sbin:/usr/sbin command -v ldconfig)
if [ -n "$LDCONFIG" ] && CACHE=$("$LDCONFIG" -p 2> /dev/null); then
    has() {
        for lib; do
            echo "$CACHE" | grep -q "^[[:space:]]*$lib $TAG" && return 0
        done
        return 1
    }
    missing=
    has libGL.so.1 libEGL.so.1 || missing="$missing OpenGL (libGL.so.1, libEGL.so.1),"
    has libX11.so.6 libwayland-client.so.0 || missing="$missing X11 or Wayland (libX11.so.6, libwayland-client.so.0),"
    has libpulse.so.0 libpipewire-0.3.so.0 libasound.so.2 || missing="$missing sound (libpulse.so.0, libasound.so.2),"
    if [ -n "$missing" ]; then
        echo "reg2: $BITS-bit libraries not found:${missing%,}." >&2
        echo "reg2: $HERE/README.md lists the packages to install." >&2
    fi
fi
exec "$HERE/bin/reg2" "$@"
