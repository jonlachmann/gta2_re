#!/bin/sh
# Starts the game (bin/gta2, 32-bit) after checking that the system has the 32-bit libraries it needs.
HERE=$(dirname "$(readlink -f "$0")")
if [ ! -e /lib/ld-linux.so.2 ]; then
    echo "gta2: this system has no 32-bit libraries (/lib/ld-linux.so.2 is missing)." >&2
    echo "gta2: $HERE/README.md lists the packages to install." >&2
    exit 1
fi

# The libraries SDL loads when it starts, from the loader's cache (ldconfig -p lists 32-bit ones as "(libc6)").
LDCONFIG=$(PATH=$PATH:/sbin:/usr/sbin command -v ldconfig)
if [ -n "$LDCONFIG" ] && CACHE=$("$LDCONFIG" -p 2> /dev/null); then
    has() {
        for lib; do
            echo "$CACHE" | grep -q "^[[:space:]]*$lib (libc6)" && return 0
        done
        return 1
    }
    missing=
    has libGL.so.1 libEGL.so.1 || missing="$missing OpenGL (libGL.so.1, libEGL.so.1),"
    has libX11.so.6 libwayland-client.so.0 || missing="$missing X11 or Wayland (libX11.so.6, libwayland-client.so.0),"
    has libpulse.so.0 libpipewire-0.3.so.0 libasound.so.2 || missing="$missing sound (libpulse.so.0, libasound.so.2),"
    if [ -n "$missing" ]; then
        echo "gta2: 32-bit libraries not found:${missing%,}." >&2
        echo "gta2: $HERE/README.md lists the packages to install." >&2
    fi
fi
exec "$HERE/bin/gta2" "$@"
