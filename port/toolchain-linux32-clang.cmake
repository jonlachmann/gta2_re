set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR i686)
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET i686-pc-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET i686-pc-linux-gnu)
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_LIBRARY_ARCHITECTURE "")
set(CMAKE_SYSTEM_LIBRARY_PATH /usr/lib32)
set(CMAKE_PREFIX_PATH /usr/lib32/cmake)
set(FIND_LIBRARY_USE_LIB32_PATHS ON)
